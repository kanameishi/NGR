
% Generated by hand for the Quarto/YAML helper API.
\name{quartoYaml}
\alias{quartoReadFrontmatter}
\alias{quartoAsSequence}
\alias{quartoHasBookManifest}
\alias{quartoSetProjectRender}
\alias{quartoMergeBookManifest}
\alias{quartoDocxBookProfile}
\alias{quartoAsYaml}
\alias{quartoWriteYaml}
\title{Quarto YAML helper functions}
\usage{
quartoReadFrontmatter(path)

quartoAsSequence(x)

quartoHasBookManifest(frontmatter)

quartoSetProjectRender(base, render)

quartoMergeBookManifest(base, manifest)

quartoDocxBookProfile(profile)

quartoAsYaml(x)

quartoWriteYaml(x, path = NULL)
}
\arguments{
\item{path}{Character scalar path.}
\item{x}{Object to coerce or serialize.}
\item{frontmatter}{Parsed QMD frontmatter list.}
\item{base}{Parsed base Quarto YAML list.}
\item{render}{Character vector or list of render targets.}
\item{manifest}{Parsed qrt-style book manifest frontmatter.}
\item{profile}{Parsed DOCX profile YAML list.}
}
\description{
Small helpers for R callers that need qrt-style Quarto runtime YAML behavior
without shelling out to qrt runtime scripts.
}
\details{
The helpers preserve single-entry sequence fields and serialize logical values as
YAML 1.2 booleans (\code{true}/\code{false}) for Quarto compatibility.

\code{quartoMergeBookManifest()} carries \code{title}, \code{author},
\code{chapters}, \code{appendices}, \code{bibliography}, \code{lang},
\code{language}, \code{toc-title}, \code{footer-title} and
\code{footer-meta} from the book master into the configuration, and merges
the master's \code{crossref} entries over the shared block, so a master in
another language overrides the \code{yml/} declarations of the project.
}
\value{
Lists for merge/transform helpers, a logical for \code{quartoHasBookManifest},
YAML text for \code{quartoAsYaml} and \code{quartoWriteYaml(path = NULL)}, or
invisible \code{path} when \code{quartoWriteYaml()} writes to disk.
}
